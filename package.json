{
  "name": "dshpack-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "scripts": {
    "build": "pnpm --recursive build && pnpm schemas:generate",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "pack:validate": "node scripts/validate-example-pack.mjs",
    "compose:validate": "node scripts/validate-example-compose.mjs",
    "schemas:generate": "node scripts/generate-pack-schemas.mjs",
    "verify:pack-schema": "node scripts/verify-pack-schema.mjs",
    "verify:adr-text-encoding": "node scripts/verify-adr-text-encoding.mjs",
    "verify:readme-commands": "node scripts/verify-readme-commands.mjs",
    "verify:release-pack": "node scripts/verify-release-pack.mjs",
    "pack:dry-run": "pnpm --filter @dshpack/core pack --dry-run && pnpm --filter dshpack pack --dry-run",
    "publint": "publint packages/core && publint packages/cli",
    "check": "pnpm --recursive build && pnpm typecheck && pnpm lint && pnpm verify:pack-schema && pnpm verify:adr-text-encoding && pnpm verify:readme-commands && pnpm test && pnpm test:e2e && pnpm pack:validate && pnpm compose:validate",
    "check:ci": "pnpm --recursive build && pnpm typecheck && pnpm lint && pnpm verify:pack-schema && pnpm verify:adr-text-encoding && pnpm verify:readme-commands && pnpm pack:validate && pnpm compose:validate",
    "release:check": "pnpm check && pnpm pack:dry-run && pnpm verify:release-pack && pnpm publint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@changesets/cli": "3.0.0",
    "@types/node": "22.20.1",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.9.0",
    "publint": "0.3.23",
    "tar": "7.5.22",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
