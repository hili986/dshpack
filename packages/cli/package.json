{
  "name": "dshpack",
  "version": "0.5.5",
  "private": false,
  "description": "CLI for packaging and managing DSH distributions.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "author": "dsh-packs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hili986/dshpack.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hili986/dshpack#readme",
  "bugs": {
    "url": "https://github.com/hili986/dshpack/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "pack",
    "plugin"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "dshpack": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run test/exit-codes.test.ts",
    "test:e2e": "pnpm run build && vitest run --root ../.. --config vitest.e2e.config.ts packages/cli/test/help.e2e.test.ts packages/cli/test/install.e2e.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@dshpack/core": "workspace:*",
    "commander": "15.0.0",
    "execa": "10.0.1",
    "fast-glob": "3.3.3",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "undici": "8.10.0",
    "yaml": "2.9.0"
  }
}
