{
  "name": "@dshpack/core",
  "version": "0.5.6",
  "private": false,
  "description": "Side-effect-free core contracts and operations for dshpack.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "author": "dsh-packs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hili986/dshpack.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/hili986/dshpack#readme",
  "bugs": {
    "url": "https://github.com/hili986/dshpack/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "pack",
    "plugin"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/pack.schema.json": "./schemas/pack.schema.json",
    "./schemas/pack-lock.schema.json": "./schemas/pack-lock.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "gray-matter": "4.0.3",
    "semver": "7.8.5",
    "yaml": "2.9.0"
  }
}
