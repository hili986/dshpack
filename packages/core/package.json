{
  "name": "@dshpack/core",
  "version": "0.0.0",
  "private": false,
  "description": "Side-effect-free core contracts and operations for dshpack.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "gray-matter": "4.0.3",
    "semver": "7.8.5",
    "yaml": "2.9.0"
  }
}
