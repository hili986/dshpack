node_modules/
.pnpm-store/
.corepack-shims/
.corepack-portable/

# Build, test, and generated artifacts
dist/
coverage/
.turbo/
*.tsbuildinfo
*.tgz

# Local environment and logs
.env
.env.*
!.env.example
*.log
codex-goals/
.omx/
